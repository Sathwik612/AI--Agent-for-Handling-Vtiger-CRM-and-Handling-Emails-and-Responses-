# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# ---- General ----
APP_ENV=development
LOG_LEVEL=INFO
# Generate with: python scripts/generate_secret.py
APP_SECRET_KEY=change-me

# ---- Database (docker-compose uses these for the postgres container too) ----
POSTGRES_USER=emailagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=emailagent
# Inside docker-compose the host is "db". Running outside Docker, use localhost.
DATABASE_URL=postgresql+psycopg://emailagent:change-me@db:5432/emailagent

# ---- Mail accounts ----
# List the account keys; each key needs the settings below.
MAIL_ACCOUNTS=kaitlyn,patricia

MAIL_KAITLYN_ADDRESS=kaitlyn.kristy@lumoslearning.com
MAIL_KAITLYN_PASSWORD=
# Optional: the name customers see on emails sent from this mailbox
# MAIL_KAITLYN_DISPLAY_NAME=
MAIL_KAITLYN_MARKET=Ohio OST
MAIL_KAITLYN_TIMEZONE=America/New_York
MAIL_KAITLYN_IMAP_HOST=c11312.sgvps.net
MAIL_KAITLYN_IMAP_PORT=993
MAIL_KAITLYN_SMTP_HOST=c11312.sgvps.net
MAIL_KAITLYN_SMTP_PORT=465

MAIL_PATRICIA_ADDRESS=patricia.williams@lumoslearning.com
MAIL_PATRICIA_PASSWORD=
# MAIL_PATRICIA_DISPLAY_NAME=
MAIL_PATRICIA_MARKET=Texas STAAR
MAIL_PATRICIA_TIMEZONE=America/Chicago
MAIL_PATRICIA_IMAP_HOST=c11312.sgvps.net
MAIL_PATRICIA_IMAP_PORT=993
MAIL_PATRICIA_SMTP_HOST=c11312.sgvps.net
MAIL_PATRICIA_SMTP_PORT=465

# ---- AI (used from Milestone 5) ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- Vtiger CRM (used from Milestone 9) ----
VTIGER_BASE_URL=https://llcrm.lumoslearning.com
VTIGER_USERNAME=
VTIGER_ACCESS_KEY=

# ---- Workflow ----
# Default behaviour is DRAFT-ONLY: nothing is sent without your approval.
SEND_MODE=draft_only
# Reporting/display timezone for the dashboard (your local time)
OPERATOR_TIMEZONE=Asia/Kolkata

# ---- What the agent may work on (edit these; nothing is hard-coded) ----
# States as 2-letter codes or full names. EMPTY = nothing is in scope (fail-closed).
AGENT_ALLOWED_STATES=OH,TX
# BDA names exactly as written in Vtiger's BDA field, comma-separated.
AGENT_ALLOWED_BDAS=Rupa
# Off-hours window (in OPERATOR_TIMEZONE): the agent covers mail arriving from START until
# END the next morning. Mail arriving during the BDAs' day is left to the BDAs.
WINDOW_START=18:30
WINDOW_END=10:00
# Days the BDAs work (in OPERATOR_TIMEZONE). Saturday/Sunday are then fully off-hours.
WORK_DAYS=MON,TUE,WED,THU,FRI
# Notification-only senders to skip before any AI call (comma-separated domains)
AUTOMATED_SENDER_DOMAINS=calendly.com
